language = "php"

run = [
    "php", "artisan", "serve",
    "--host", "0.0.0.0",
    "--port", "8000"
]

entrypoint = "routes/web.php"

hidden = [
    "artisan",

    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    ".styleci.yml",

    "composer.lock",
    "vendor",
    "phpunit.xml"
]
modules = ["php-8.4"]

[packager]
language = "php"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan serve --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
DB_CONNECTION = "sqlite"
DB_DATABASE = "/home/runner/workspace/database/portfolio.sqlite"
ADMIN_PASSWORD = "admin123"
