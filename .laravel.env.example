# Copy to .laravel.env (this app loads .laravel.env, not .env — see bootstrap/app.php)
# then run: php artisan key:generate

APP_NAME="Baraa Abu Draz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Password for /admin. Required — there is no safe default.
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The site's content lives in database/portfolio.sqlite (not tracked by Git).
# DB_DATABASE is optional; it defaults to database/portfolio.sqlite.
DB_CONNECTION=sqlite

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
