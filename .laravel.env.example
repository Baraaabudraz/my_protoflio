# Copy to .laravel.env (this app loads .laravel.env, not .env — see bootstrap/app.php)
# then run: php artisan key:generate

APP_NAME="Baraa Abu Draz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Password for /admin. Required — there is no safe default.
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The site's content lives in database/portfolio.sqlite (not tracked by Git).
# DB_DATABASE is optional; it defaults to database/portfolio.sqlite.
DB_CONNECTION=sqlite

# Image processing for project galleries: "gd" or "imagick" (defaults to imagick when installed)
# IMAGE_DRIVER=gd

# ─── Email (contact form) ───
# Any SMTP server works. Examples:
#   Gmail:   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  (use a Google "App password", not your normal password)
#   Brevo:   MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
#   Hosting: your cPanel mail server, e.g. MAIL_HOST=mail.your-domain.com  MAIL_PORT=465  MAIL_SCHEME=smtps
# Other drivers: MAIL_MAILER=postmark | ses | mailgun | resend (see config/mail.php).
# Use MAIL_MAILER=log locally to write emails to storage/logs/laravel.log instead of sending them.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be an address your mail server is allowed to send from
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where inquiries are delivered (defaults to the email in Admin → Settings)
MAIL_CONTACT_TO=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
